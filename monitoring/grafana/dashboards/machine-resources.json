  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Machine resources",
      "type": "link",
      "url": "/d/machine-resources"
    },
    {
      "title": "Usage",
      "type": "link",
      "url": "/d/usage"
    }
